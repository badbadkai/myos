{
  "name": "myos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kai's personal OS - a PWA write-head onto the Hub vault (daily notes, finance, calendar).",
  "scripts": {
    "dev": "concurrently -n bridge,web -c magenta,cyan \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:bridge": "node server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "concurrently -n bridge,web -c magenta,cyan \"npm:dev:bridge\" \"npm:preview\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
